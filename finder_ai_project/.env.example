# Copiez ce fichier en `.env` et renseignez les valeurs.
# En production, privilégiez GCP Secret Manager (via env injectées dans Cloud Run).

# ─── Clés obligatoires ──────────────────────────────────────────────────
# SECRET_KEY : générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour CSRF (ex: https://votre-domaine.fr,https://*.run.app)
CSRF_TRUSTED_ORIGINS=

# ─── APIs externes ─────────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Base de données ───────────────────────────────────────────────────
# Exemple PostgreSQL : postgres://user:pass@/dbname?host=/cloudsql/INSTANCE
DATABASE_URL=

# ─── Sécurité / HTTPS (True en production) ─────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ─── Rate-limiting d'authentification (django-axes) ────────────────────
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=2

# ─── Planificateur de scraping ─────────────────────────────────────────
SCRAPER_ENABLED=False
SCRAPER_TARGET_URL=https://github.com/trending
